# Puerto de la API
PORT=3000

# Orígenes permitidos para CORS (separados por coma)
WEB_ORIGIN=http://localhost:5173

# Conexión a PostgreSQL. Ajustá usuario, contraseña y nombre de la base.
# Debe existir la base (ej.: CREATE DATABASE inventario3d;).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventario3d?schema=public"
