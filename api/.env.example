# Puerto de la API
PORT=3000

# Orígenes permitidos para CORS (separados por coma)
WEB_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Base de datos.
# Desarrollo: SQLite (archivo local, sin servidor).
DATABASE_URL="file:./dev.db"
# Secreto para firmar los JWT (en producción, usar un valor largo y privado)
JWT_SECRET="cambiar-por-un-secreto-largo-y-privado"
# Producción (PostgreSQL): poné provider = "postgresql" en prisma/schema.prisma y usá:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventario3d?schema=public"
