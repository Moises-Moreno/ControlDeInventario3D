// ARCHIVO GENERADO por scripts/pg-schema.mjs: no editar. Se edita prisma/schema.prisma.
// Modelo de datos del inventario (Etapa 3).
// Restricciones clave: código de producto y nombre de rack únicos, y una única
// posición ocupada por (rack, nivel, posición). La baja de pallet es lógica (status).

generator client {
  provider = "prisma-client-js"
}

// Para desarrollo usamos SQLite (sin servidor). El mismo modelo sirve para
// PostgreSQL en producción: se cambia provider a "postgresql" y se re-migra.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            Int            @id @default(autoincrement())
  /// Id / código del producto (único, en mayúsculas).
  code          String         @unique
  name          String
  /// Unidad de medida del contenido: L, kg, un...
  unit          String         @default("un")
  /// Foto del producto (data URL JPEG reducida).
  photo         String?
  color         String
  active        Boolean        @default(true)
  example       Boolean        @default(false)
  createdAt     DateTime       @default(now()) @map("created_at")
  presentations Presentation[]
  pallets       Pallet[]

  @@map("products")
}

/// Forma en que viene el producto: contenido por envase, envases por caja y
/// cómo se arma un pallet completo (frente × fondo × niveles).
model Presentation {
  id             Int             @id @default(autoincrement())
  productId      Int             @map("product_id")
  product        Product         @relation(fields: [productId], references: [id])
  name           String
  contentPerUnit Float           @default(1) @map("content_per_unit")
  unitsPerBox    Int             @map("units_per_box")
  front          Int             @default(5)
  depth          Int             @default(2)
  levels         Int             @default(4)
  active         Boolean         @default(true)
  pallets        Pallet[]
  lines          ReceptionLine[]

  @@map("presentations")
}

model Rack {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  levels    Int
  positions Int
  pallets   Pallet[]

  @@map("racks")
}

model Pallet {
  id        Int        @id @default(autoincrement())
  /// Código correlativo PAL-001 (se asigna al crear). Nullable solo durante la creación.
  code      String?    @unique
  productId Int        @map("product_id")
  product   Product    @relation(fields: [productId], references: [id])
  presentationId Int?  @map("presentation_id")
  presentation   Presentation? @relation(fields: [presentationId], references: [id])
  receptionId    Int?  @map("reception_id")
  reception      Reception?    @relation(fields: [receptionId], references: [id])
  front     Int
  depth     Int
  rows      Int
  loose     Int
  lote      String     @default("")
  vence     String     @default("")
  // Ubicación (nula si está sin ubicar)
  rackId    Int?       @map("rack_id")
  rack      Rack?      @relation(fields: [rackId], references: [id])
  level     Int?
  pos       Int?
  /// activo | baja (baja lógica para conservar el historial)
  status    String     @default("activo")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  movements Movement[]

  // Una sola posición ocupada por celda. Los nulos (sin ubicar) son distintos en Postgres.
  @@unique([rackId, level, pos], name: "uniq_position")
  @@map("pallets")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  /// admin | operador
  role         String   @default("operador")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Movement {
  id        Int      @id @default(autoincrement())
  palletId  Int      @map("pallet_id")
  pallet    Pallet   @relation(fields: [palletId], references: [id])
  /// alta | recuento | ubicacion | traslado | baja
  type      String
  fromText  String?  @map("from_text")
  toText    String?  @map("to_text")
  user      String   @default("sistema")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("movements")
}

/// Recepción de mercadería. Las recepciones no se borran: se anulan.
model Reception {
  id           Int              @id @default(autoincrement())
  code         String           @unique
  /// confirmada | anulada
  status       String           @default("confirmada")
  receivedAt   DateTime         @default(now()) @map("received_at")
  /// Usuario que registró la recepción.
  user         String
  /// Firma de quien recepciona (data URL PNG).
  signature    String?
  observations String           @default("")
  photos       ReceptionPhoto[]
  lines        ReceptionLine[]
  pallets      Pallet[]

  @@map("receptions")
}

model ReceptionPhoto {
  id          Int       @id @default(autoincrement())
  receptionId Int       @map("reception_id")
  reception   Reception @relation(fields: [receptionId], references: [id])
  /// Foto del estado de la mercadería (data URL JPEG reducida).
  data        String

  @@map("reception_photos")
}

model ReceptionLine {
  id             Int          @id @default(autoincrement())
  receptionId    Int          @map("reception_id")
  reception      Reception    @relation(fields: [receptionId], references: [id])
  presentationId Int          @map("presentation_id")
  presentation   Presentation @relation(fields: [presentationId], references: [id])
  /// Cantidad recibida en la unidad de medida del producto (p. ej. 5000 L).
  quantity       Float
  boxes          Int
  /// Envases que sobraron y no completan una caja.
  leftoverUnits  Int          @default(0) @map("leftover_units")
  lote           String       @default("")
  vence          String       @default("")

  @@map("reception_lines")
}
